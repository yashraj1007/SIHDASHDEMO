{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "wellbore_sentry": {
      "root": "site"
    },
    "react_frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/react",
      "destination": {
        "service": "react_frontend",
        "path": "/"
      }
    },
    {
      "source": "/react/:path*",
      "destination": {
        "service": "react_frontend",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "wellbore_sentry"
      }
    }
  ]
}
